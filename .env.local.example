# Copy to .env.local (already gitignored) and fill in from your Supabase
# project's Settings -> API page.

# Used at build time by app/page.tsx and app/events/[eventId]/page.tsx to
# read gallery data. Safe to expose — read-only, RLS-scoped.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used only by scripts/register-event.mjs (never referenced from app code).
# Keep this out of anything that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LuxSync instance that reads/caches the Drive folders events point at.
# Defaults to the production instance if unset.
NEXT_PUBLIC_LUXSYNC_URL=https://luxsync-v3.thebooleanjulian.dev

# Instagram Graph API token for the homepage's Instagram section
# (lib/instagram.ts). From Meta App Dashboard -> Instagram -> API setup
# with Instagram Login -> Generate token, for the xymiku.39 account.
# Read only at build time — never exposed to the browser, so no
# NEXT_PUBLIC_ prefix. Expires ~60 days after generation; regenerate and
# replace it here AND in Zeabur's project environment variables when it
# does. Leave unset and the Instagram section falls back to the RSS.app
# feed (capped at 6 posts) instead.
INSTAGRAM_ACCESS_TOKEN=
